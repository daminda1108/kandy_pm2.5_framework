# Track the source that builds the thesis, not the build products.
# Diagrams and figures are regenerated by scripts in src/ and are large binaries; a thesis
# repository that carries every intermediate png becomes unusable within a month.
thesis/diagrams/*.png
thesis/diagrams/*.pdf
thesis/figures/*.png
thesis/figures/*.pdf
build/*.docx
build/reference.docx
__pycache__/
*.pyc
build/thesis.md
build/thesis.docx
build/_pandoc_default.docx
