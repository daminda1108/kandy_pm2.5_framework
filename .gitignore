# =============================================================================
# Kandy PM2.5 — .gitignore
# POLICY: Only model source code is committed to git.
#   Tracked: kandy_pm25/src/**, kandy_pm25/config.py, requirements.txt,
#            README.md, .gitignore, run_pipeline.py, SETUP_GUIDE.md
#   NOT tracked: data, results, visualisation scripts, report/analysis
#                scripts, project-management docs, credentials, notebooks.
# =============================================================================


# ── Python environment ────────────────────────────────────────────────────────
.venv/
venv/
env/
.env
.Python


# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd


# ── Data (too large for Git) ─────────────────────────────────────────────────
kandy_pm25/data/


# ── Results & model outputs ──────────────────────────────────────────────────
kandy_pm25/results/


# ── Utility scripts: ignore contents by default; the transfer-validation
#    evidence pipeline is re-included in kandy_pm25/.gitignore (2026-07-02,
#    versioned for preprint reproducibility). Trailing /* (not /) so the
#    nested .gitignore can negate specific files. ──────────────────────────
kandy_pm25/scripts/*


# ── Report generators (documentation tools, not model code) ─────────────────
kandy_pm25/reports/


# ── Large binary / data file types (belt-and-suspenders) ─────────────────────
*.nc
*.nc4
*.tif
*.tiff
*.geotiff
*.parquet
*.npz
*.npy
*.h5
*.hdf5
*.pkl
*.joblib
*.ubj
*.bin
*.csv
*.json
*.zip
*.tar
*.tar.gz
*.gz
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx


# ── Jupyter ───────────────────────────────────────────────────────────────────
*.ipynb
.ipynb_checkpoints/


# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/


# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
nul


# ── API credentials — never commit ───────────────────────────────────────────
.cdsapirc
.netrc
*.env
secrets/
API.txt


# ── Internal working / project-management documents (not model code) ─────────
CLAUDE.md
PROJECT.md
PROJECT_CONTEXT.md
RESEARCH_PROJECT_DESIGN.md
STAGE1_ANALYSIS.md
READ\ Me.txt
READ\ ME.txt


# ── Root-level ad-hoc scripts and output files ───────────────────────────────
/inspect_data.py
/parse_xlsx.py
/inspect_out.txt
/result.txt


# ── Root-level scripts directory (vault tools, map scripts) ──────────────────
/scripts/


# ── Local tooling installs + their outputs (WindNinja diagnostic-wind model) ──
# WindNinja portable install, the downloaded installer, and its run outputs live
# under tools/ — large binaries, never tracked. The model integration that uses
# them lives in kandy_pm25/src/ (terrain_transport.py) and IS tracked.
/tools/


# ── Standalone model release (its own git repo: daminda1108/kandy_pm25_model) ──
# kandy_pm25_release/ is an isolated copy of the production decomposition model
# with its own git history and remote. The parent repo must NOT track it.
/kandy_pm25_release/


# ── Session artifacts (handoff notes, working docs) ──────────────────────────
artifacts/


# ── Root-level reports directory (markdown deliverables, not source) ─────────
/reports/


# ── Obsidian canvas scratch files ────────────────────────────────────────────
*.canvas


# ── Training artifacts / logs / figures (not source) ─────────────────────────
*.log
*.png
catboost_info/


# ── Kaggle kernel scripts (managed via kaggle CLI, not git) ──────────────────
*_kaggle.py
kaggle_kernel/
kaggle_checkpoint_dataset/


# ── Visualisation and analysis scripts (not model code) ──────────────────────
# These are run locally to inspect results; they are not part of the model.
visualise_*.py
kandy_pm25/src/**/visualise_*.py


# ── Project-level directories that are NOT source code ───────────────────────
archive/
docs/
references/
knowledge_base/
.obsidian/
.claude/
.gemini/


# ── Node.js (if any) ─────────────────────────────────────────────────────────
node_modules/
package.json
package-lock.json
extract_all_books.bat
extract_smallest_book.bat

# standalone webapps (own repos)
kandy_webapp/
medellin_webapp/

# PhD supervisor-finder tool (personal, not research)
saf/
