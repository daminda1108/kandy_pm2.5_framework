# =============================================================================
# Kandy PM2.5 — .gitignore
# Tracked: source code (kandy_pm25/src/**), config, requirements, README,
#          run_pipeline.py, SETUP_GUIDE.md, .gitignore
# =============================================================================


# ── Python environment ────────────────────────────────────────────────────────
.venv/
venv/
env/
.env
.Python


# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd


# ── Data (too large for Git) ─────────────────────────────────────────────────
kandy_pm25/data/


# ── Results & model outputs ──────────────────────────────────────────────────
kandy_pm25/results/


# ── Utility scripts (not model code, kept locally) ──────────────────────────
kandy_pm25/scripts/


# ── Report generators (documentation tools, not model code) ─────────────────
kandy_pm25/reports/


# ── Large binary / data file types (belt-and-suspenders) ─────────────────────
*.nc
*.nc4
*.tif
*.tiff
*.geotiff
*.parquet
*.npz
*.npy
*.h5
*.hdf5
*.pkl
*.joblib
*.ubj
*.bin
*.csv
*.json
*.zip
*.tar
*.tar.gz
*.gz
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx


# ── Jupyter ───────────────────────────────────────────────────────────────────
*.ipynb
.ipynb_checkpoints/


# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/


# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
nul


# ── API credentials — never commit ───────────────────────────────────────────
.cdsapirc
.netrc
*.env
secrets/
API.txt


# ── Internal working documents (not public-facing) ───────────────────────────
CLAUDE.md
PROJECT_CONTEXT.md
RESEARCH_PROJECT_DESIGN.md
STAGE1_ANALYSIS.md
READ\ Me.txt
READ\ ME.txt


